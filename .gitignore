# ==========================================
# Godot 4+ ignores
# ==========================================
.godot/
*.translation

# ==========================================
# Build, Exports & Installer Outputs
# ==========================================
build/
test_export/
installer/
android/

# Binaries, packages, & archives
*.exe
*.dll
*.pck
*.zip
*.7z
*.rar
*.tar.gz
*.msi

# ==========================================
# .NET / C# / IDE
# ==========================================
bin/
obj/
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ==========================================
# Office Documents & Reports
# ==========================================
*.docx
*.doc
*.pptx
*.xlsx
*.pdf

# ==========================================
# Documentation: only track .md files
# ==========================================
docs/*
!docs/**/
!docs/*.md
!docs/**/*.md

# ==========================================
# OS / System Files
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
